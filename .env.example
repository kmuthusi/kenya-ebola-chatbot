# Copy to .env and adjust for the deployment host.
# Use an absolute path to the reviewed guideline PDF when deploying elsewhere.
GUIDELINE_SOURCE=./Final Case Management Guidelines for Ebola Virus- 23102026 V5.pdf
APP_PORT=8501
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_KEEP_ALIVE=30m
EVIDENCE_PASSAGES=5
MAX_CONCURRENT_ANSWERS=2
# Required only when using compose.public.yaml. Point DNS to the deployment host.
# SITE_DOMAIN=chat.example.org
